{
  "version": "2.9.0",
  "name": "repo-kit v2.9.0",
  "include": [],
  "frontmatter_exempt": {
    "names": [
      "CHANGELOG.md",
      "CONTRIBUTING.md",
      "README.md",
      "REPO_STANDARD.md",
      "SECURITY.md"
    ],
    "paths": []
  },
  "skills": {
    "glob": "skills/**/SKILL.md",
    "schema": "schema/skills.schema.json",
    "name_matches_dir": true,
    "min_description": 40
  },
  "types": [
    "tutorial",
    "how-to",
    "reference",
    "explanation"
  ],
  "kinds": [
    "standard",
    "decision",
    "index",
    "note",
    "glossary",
    "report",
    "pitfall"
  ],
  "statuses": [
    "draft",
    "active",
    "resolved",
    "superseded",
    "archived"
  ],
  "tiers": [
    "normal",
    "critical"
  ],
  "confidences": [
    "low",
    "medium",
    "high"
  ],
  "topics": [
    "auth",
    "config",
    "governance",
    "pricing",
    "onboarding"
  ],
  "relations": {
    "depends-on": {
      "direction": "directed",
      "inverse": "depended-on-by",
      "transitive": false
    },
    "extends": {
      "direction": "directed",
      "inverse": "extended-by",
      "transitive": true
    },
    "spawned-from": {
      "direction": "directed",
      "inverse": "spawned",
      "transitive": false
    },
    "supersedes": {
      "direction": "directed",
      "inverse": "superseded-by",
      "transitive": false
    },
    "contradicts": {
      "direction": "symmetric",
      "inverse": null,
      "transitive": false
    },
    "see-also": {
      "direction": "symmetric",
      "inverse": null,
      "transitive": false
    }
  },
  "review_days": {
    "normal": 365,
    "critical": 90
  },
  "generated_files": [
    "AGENTS.md",
    "llms.txt",
    "docs/_generated/index.md",
    "docs/_generated/backlinks.md",
    "docs/_generated/pitfalls.md"
  ],
  "ignore": [
    ".github/**",
    "tests/**",
    "**/node_modules/**",
    "**/.venv/**",
    "**/__pycache__/**"
  ]
}
